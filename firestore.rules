rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBranchId(branchId) {
      return branchId is string && branchId.size() >= 1 && branchId.size() <= 64 && branchId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStaffDocId(adminId) {
      return adminId is string && adminId.size() >= 3 && adminId.size() <= 128 && adminId.matches('^[a-zA-Z0-9_.+\\-@]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Bootstrapped SuperAdmin check with verified email guard (prevents email spoofing)
    function isSuperAdminToken() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email is string &&
             request.auth.token.email.lower() == 'uk9798989@gmail.com';
    }

    function isSuperAdmin() {
      return isSuperAdminToken() ||
             (isSignedIn() &&
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SuperAdmin');
    }

    // Dynamic Multi-Branch Admin Check:
    // Looks up /branch_admins/{lowercaseEmail} directly so revoking or reassigning
    // a manager takes effect INSTANTLY across all existing and new orders of any branch.
    function isBranchAdminFor(branchId) {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email is string &&
             isValidBranchId(branchId) &&
             exists(/databases/$(database)/documents/branch_admins/$(request.auth.token.email.lower())) &&
             get(/databases/$(database)/documents/branch_admins/$(request.auth.token.email.lower())).data.role == 'BranchAdmin' &&
             get(/databases/$(database)/documents/branch_admins/$(request.auth.token.email.lower())).data.branchId == branchId;
    }

    // 3. Entity Validation Blueprints
    function isValidBranch(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
             data.shortLabel is string && data.shortLabel.size() >= 2 && data.shortLabel.size() <= 40 &&
             data.shortAddress is string && data.shortAddress.size() >= 3 && data.shortAddress.size() <= 160 &&
             data.areas is list && data.areas.size() <= 30 &&
             (data.areas.size() == 0 || data.areas[0] is string) &&
             (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
             (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
             (!('mapUrl' in data) || (data.mapUrl is string && data.mapUrl.size() <= 300)) &&
             (!('openHours' in data) || (data.openHours is string && data.openHours.size() <= 60)) &&
             (!('deliveryRadiusKm' in data) || (data.deliveryRadiusKm is int && data.deliveryRadiusKm >= 1 && data.deliveryRadiusKm <= 100)) &&
             data.active is bool &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000;
    }

    function isValidMenuItem(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.description is string && data.description.size() <= 300 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.pricePkr is int && data.pricePkr > 0 && data.pricePkr <= 100000 &&
             data.imageKey is string && data.imageKey.size() >= 1 && data.imageKey.size() <= 50 &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 220000)) &&
             data.badgeText is string && data.badgeText.size() <= 30 &&
             data.available is bool &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 120 &&
             data.displayName is string && data.displayName.size() <= 80 &&
             data.role in ['Customer', 'BranchAdmin', 'SuperAdmin'] &&
             (data.assignedBranchId == '' || isValidBranchId(data.assignedBranchId)) &&
             data.favoriteItemIds is list && data.favoriteItemIds.size() <= 50 &&
             (data.favoriteItemIds.size() == 0 || data.favoriteItemIds[0] is string);
    }

    function isValidSavedAddress(data) {
      return data.label is string && data.label.size() >= 1 && data.label.size() <= 40 &&
             data.streetAddress is string && data.streetAddress.size() >= 3 && data.streetAddress.size() <= 200 &&
             data.area is string && data.area.size() >= 1 && data.area.size() <= 60 &&
             isValidBranchId(data.branchId) &&
             data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80;
    }

    function isValidBranchAdmin(data) {
      return data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
             data.email == data.email.lower() &&
             data.role == 'BranchAdmin' &&
             isValidBranchId(data.branchId) &&
             data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80;
    }

    function isValidPromotion(data) {
      return data.code is string && data.code.size() >= 2 && data.code.size() <= 30 &&
             data.discountType in ['PERCENT', 'FLAT'] &&
             data.discountValue is int &&
             ((data.discountType == 'PERCENT' && data.discountValue >= 1 && data.discountValue <= 90) ||
              (data.discountType == 'FLAT' && data.discountValue >= 1 && data.discountValue <= 100000)) &&
             data.minOrderPkr is int && data.minOrderPkr >= 0 && data.minOrderPkr <= 1000000 &&
             data.active is bool &&
             (!('branchId' in data) || data.branchId == '' || isValidBranchId(data.branchId)) &&
             (!('branchName' in data) || (data.branchName is string && data.branchName.size() <= 80)) &&
             (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is timestamp);
    }

    function isValidBranchBanner(data) {
      return isValidBranchId(data.branchId) &&
             data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 80 &&
             data.subtitle is string && data.subtitle.size() <= 200 &&
             data.promoCode is string && data.promoCode.size() <= 30 &&
             data.badgeText is string && data.badgeText.size() <= 30 &&
             data.imageUrl is string && data.imageUrl.size() >= 8 && data.imageUrl.size() <= 220000 &&
             data.targetCategory is string && data.targetCategory.size() >= 1 && data.targetCategory.size() <= 40 &&
             data.active is bool &&
             (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is timestamp);
    }

    function isValidOrder(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.guestSessionId is string && data.guestSessionId.size() <= 40 &&
             data.guestCheckout is bool &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
             data.customerEmail is string && data.customerEmail.size() <= 120 &&
             data.customerPhone is string && data.customerPhone.size() <= 30 &&
             data.orderType in ['DELIVERY', 'PICKUP'] &&
             data.deliveryAddress is string && data.deliveryAddress.size() <= 250 &&
             isValidBranchId(data.branchId) &&
             data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80 &&
             data.branchAdminEmails is list && data.branchAdminEmails.size() <= 50 &&
             (data.branchAdminEmails.size() == 0 || data.branchAdminEmails[0] is string) &&
             data.items is list && data.items.size() >= 1 && data.items.size() <= 30 && data.items[0] is map &&
             data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 300 &&
             data.promoCode is string && data.promoCode.size() <= 30 &&
             data.discountPkr is int && data.discountPkr >= 0 && data.discountPkr <= 1000000 &&
             data.subtotalPkr is int && data.subtotalPkr > 0 && data.subtotalPkr <= 1000000 &&
             data.deliveryFeePkr is int && data.deliveryFeePkr >= 0 && data.deliveryFeePkr <= 10000 &&
             data.totalPkr is int && data.totalPkr > 0 && data.totalPkr <= 1010000 &&
             data.status in ['Confirmed', 'Preparing', 'Dispatched', 'Delivered'];
    }

    function isValidReview(data) {
      return data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 128 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
             isValidBranchId(data.branchId) &&
             data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80 &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 400 &&
             data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 300;
    }

    function isValidFcmToken(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.token is string && data.token.size() >= 10 && data.token.size() <= 512 &&
             data.platform == 'android' &&
             data.appVersion is string && data.appVersion.size() >= 1 && data.appVersion.size() <= 30;
    }

    function isValidCafeFeedback(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
             data.customerEmail is string && data.customerEmail.size() <= 120 &&
             isValidBranchId(data.branchId) &&
             data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80 &&
             data.foodRating is int && data.foodRating >= 1 && data.foodRating <= 5 &&
             data.serviceRating is int && data.serviceRating >= 1 && data.serviceRating <= 5 &&
             data.comment is string && data.comment.size() <= 500;
    }

    // 4. Collection Rules

    // Branches: Readable by signed-in users, created/updated/deleted ONLY by SuperAdmin
    match /branches/{branchId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidBranchId(branchId);

      allow create: if isSuperAdmin() &&
                       isValidBranchId(branchId) &&
                       incoming().keys().hasAll(['name', 'shortLabel', 'shortAddress', 'areas', 'active', 'sortOrder', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['name', 'shortLabel', 'shortAddress', 'areas', 'latitude', 'longitude', 'mapUrl', 'openHours', 'deliveryRadiusKm', 'active', 'sortOrder', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidBranch(incoming());

      allow update: if isSuperAdmin() &&
                       isValidBranchId(branchId) &&
                       isValidBranch(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'shortLabel', 'shortAddress', 'areas', 'latitude', 'longitude', 'mapUrl', 'openHours', 'deliveryRadiusKm', 'active', 'sortOrder', 'updatedAt']);

      allow delete: if isSuperAdmin() && isValidBranchId(branchId);
    }

    // Global Menu Items: Readable by signed-in users, writable ONLY by SuperAdmin
    match /menu_items/{itemId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(itemId);

      allow create: if isSuperAdmin() &&
                       isValidId(itemId) &&
                       incoming().keys().hasAll(['name', 'description', 'category', 'pricePkr', 'imageKey', 'badgeText', 'available', 'sortOrder', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['name', 'description', 'category', 'pricePkr', 'imageKey', 'imageUrl', 'badgeText', 'available', 'sortOrder', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidMenuItem(incoming());

      allow update: if isSuperAdmin() &&
                       isValidId(itemId) &&
                       isValidMenuItem(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'category', 'pricePkr', 'imageKey', 'imageUrl', 'badgeText', 'available', 'sortOrder', 'updatedAt']);

      allow delete: if isSuperAdmin() && isValidId(itemId);
    }

    // Promotions: Readable by signed-in users; SuperAdmin manages all; BranchAdmin manages ONLY own branchId promos
    match /promotions/{promoId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(promoId);

      allow create: if isValidId(promoId) &&
                       (
                         isSuperAdmin() ||
                         (('branchId' in incoming()) &&
                          incoming().branchId is string &&
                          incoming().branchId != '' &&
                          isBranchAdminFor(incoming().branchId))
                       ) &&
                       incoming().keys().hasAll(['code', 'discountType', 'discountValue', 'minOrderPkr', 'active', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['code', 'discountType', 'discountValue', 'minOrderPkr', 'active', 'branchId', 'branchName', 'expiresAt', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidPromotion(incoming());

      allow update: if isValidId(promoId) &&
                       isValidPromotion(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         (isSuperAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['code', 'discountType', 'discountValue', 'minOrderPkr', 'active', 'branchId', 'branchName', 'expiresAt', 'updatedAt'])) ||
                         (('branchId' in existing()) &&
                          existing().branchId is string &&
                          existing().branchId != '' &&
                          isBranchAdminFor(existing().branchId) &&
                          incoming().branchId == existing().branchId &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['code', 'discountType', 'discountValue', 'minOrderPkr', 'active', 'branchName', 'expiresAt', 'updatedAt']))
                       );

      allow delete: if isValidId(promoId) &&
                       (
                         isSuperAdmin() ||
                         (('branchId' in existing()) &&
                          existing().branchId is string &&
                          existing().branchId != '' &&
                          isBranchAdminFor(existing().branchId))
                       );
    }

    // Seasonal Branch Banners: Readable by signed-in users; SuperAdmin or assigned BranchAdmin manages strictly for their branchId
    match /branch_banners/{bannerId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(bannerId);

      allow create: if isValidId(bannerId) &&
                       (isSuperAdmin() || isBranchAdminFor(incoming().branchId)) &&
                       incoming().keys().hasAll(['branchId', 'branchName', 'title', 'subtitle', 'promoCode', 'badgeText', 'imageUrl', 'targetCategory', 'active', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['branchId', 'branchName', 'title', 'subtitle', 'promoCode', 'badgeText', 'imageUrl', 'targetCategory', 'active', 'expiresAt', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidBranchBanner(incoming());

      allow update: if isValidId(bannerId) &&
                       (isSuperAdmin() || isBranchAdminFor(existing().branchId)) &&
                       isValidBranchBanner(incoming()) &&
                       incoming().branchId == existing().branchId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['branchName', 'title', 'subtitle', 'promoCode', 'badgeText', 'imageUrl', 'targetCategory', 'active', 'expiresAt', 'updatedAt']);

      allow delete: if isValidId(bannerId) &&
                       (isSuperAdmin() || isBranchAdminFor(existing().branchId));
    }

    // Users & Saved Addresses (strict PII isolation)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());
      allow list: if isSuperAdminToken();

      // Prevent privilege escalation on self-registration (must be Customer unless SuperAdmin email)
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'email', 'displayName', 'role', 'assignedBranchId', 'favoriteItemIds', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'displayName', 'role', 'assignedBranchId', 'favoriteItemIds', 'createdAt', 'updatedAt']) &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming()) &&
                       ((incoming().role == 'Customer' && incoming().assignedBranchId == '') ||
                        (isSuperAdminToken() && incoming().role == 'SuperAdmin'));

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time && (
                         (isOwner(userId) &&
                          incoming().role == existing().role &&
                          incoming().assignedBranchId == existing().assignedBranchId &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'favoriteItemIds', 'updatedAt'])) ||
                         (isSuperAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['role', 'assignedBranchId', 'displayName', 'updatedAt']))
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /addresses/{addressId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(addressId);

        allow create: if isOwner(userId) &&
                         isValidId(addressId) &&
                         incoming().keys().hasAll(['label', 'streetAddress', 'area', 'branchId', 'branchName', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['label', 'streetAddress', 'area', 'branchId', 'branchName', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidSavedAddress(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(addressId) &&
                         isValidSavedAddress(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['label', 'streetAddress', 'area', 'branchId', 'branchName', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(addressId);
      }

      match /fcm_tokens/{tokenId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(tokenId);

        allow create: if isOwner(userId) &&
                         isValidId(tokenId) &&
                         incoming().keys().hasAll(['userId', 'token', 'platform', 'appVersion', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'token', 'platform', 'appVersion', 'createdAt', 'updatedAt']) &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidFcmToken(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(tokenId) &&
                         isValidFcmToken(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['token', 'appVersion', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(tokenId);
      }
    }

    // Branch Admin Assignments (SuperAdmin creates/updates/deletes; BranchAdmin reads ONLY own assignment)
    // Document ID = lowercase email (e.g. 'manager@gmail.com') for instant zero-trust lookup & revocation.
    match /branch_admins/{adminId} {
      allow list: if isSignedIn() && (
        isSuperAdminToken() ||
        (request.auth.token.email_verified == true &&
         request.auth.token.email is string &&
         resource.data.email == request.auth.token.email.lower())
      );
      allow get: if isSignedIn() && isValidStaffDocId(adminId) && (
        isSuperAdmin() ||
        (request.auth.token.email_verified == true &&
         request.auth.token.email is string &&
         (adminId == request.auth.token.email.lower() || resource.data.email == request.auth.token.email.lower()))
      );

      allow create: if isSuperAdmin() &&
                       isValidStaffDocId(adminId) &&
                       incoming().keys().hasAll(['email', 'role', 'branchId', 'branchName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['email', 'role', 'branchId', 'branchName', 'createdAt', 'updatedAt']) &&
                       adminId == incoming().email &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidBranchAdmin(incoming());

      allow update: if isSuperAdmin() &&
                       isValidStaffDocId(adminId) &&
                       isValidBranchAdmin(incoming()) &&
                       adminId == incoming().email &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role', 'branchId', 'branchName', 'updatedAt']);

      allow delete: if isSuperAdmin() && isValidStaffDocId(adminId);
    }

    // Orders (Customer owns own orders; BranchAdmin sees ONLY assigned branchId orders; SuperAdmin sees all)
    match /orders/{orderId} {
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdminToken() ||
        isBranchAdminFor(resource.data.branchId)
      );

      allow get: if isSignedIn() && isValidId(orderId) && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin() ||
        isBranchAdminFor(resource.data.branchId)
      );

      allow create: if isSignedIn() &&
                       isValidId(orderId) &&
                       incoming().keys().hasAll(['userId', 'guestSessionId', 'guestCheckout', 'customerName', 'customerEmail', 'customerPhone', 'orderType', 'deliveryAddress', 'branchId', 'branchName', 'branchAdminEmails', 'items', 'itemsSummary', 'promoCode', 'discountPkr', 'subtotalPkr', 'deliveryFeePkr', 'totalPkr', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'guestSessionId', 'guestCheckout', 'customerName', 'customerEmail', 'customerPhone', 'orderType', 'deliveryAddress', 'branchId', 'branchName', 'branchAdminEmails', 'items', 'itemsSummary', 'promoCode', 'discountPkr', 'subtotalPkr', 'deliveryFeePkr', 'totalPkr', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'Confirmed' &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidOrder(incoming());

      // Status updates restricted to SuperAdmin or active BranchAdmin for that branch; locked once Delivered
      allow update: if isSignedIn() &&
                       isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().branchId == existing().branchId &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         isSuperAdmin() ||
                         isBranchAdminFor(existing().branchId)
                       ) &&
                       (existing().status != 'Delivered' || isSuperAdmin()) &&
                       (
                         (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                          incoming().branchAdminEmails == existing().branchAdminEmails) ||
                         (isSuperAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['branchAdminEmails', 'updatedAt']) &&
                          incoming().status == existing().status)
                       );

      allow delete: if isSuperAdmin() && isValidId(orderId);
    }

    // Reviews: Customers can submit/update reviews ONLY for their own Delivered orders; SuperAdmin can read/delete all
    match /reviews/{reviewId} {
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdminToken()
      );

      allow get: if isSignedIn() && isValidId(reviewId) && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );

      allow create: if isSignedIn() &&
                       isValidId(reviewId) &&
                       incoming().keys().hasAll(['orderId', 'userId', 'customerName', 'branchId', 'branchName', 'rating', 'comment', 'itemsSummary', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['orderId', 'userId', 'customerName', 'branchId', 'branchName', 'rating', 'comment', 'itemsSummary', 'createdAt', 'updatedAt']) &&
                       incoming().userId == request.auth.uid &&
                       incoming().orderId == reviewId &&
                       exists(/databases/$(database)/documents/orders/$(reviewId)) &&
                       get(/databases/$(database)/documents/orders/$(reviewId)).data.userId == request.auth.uid &&
                       get(/databases/$(database)/documents/orders/$(reviewId)).data.status == 'Delivered' &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidReview(incoming());

      allow update: if isSignedIn() &&
                       isValidId(reviewId) &&
                       existing().userId == request.auth.uid &&
                       isValidReview(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().orderId == existing().orderId &&
                       incoming().branchId == existing().branchId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);

      allow delete: if isSuperAdmin() && isValidId(reviewId);
    }

    // Account Settings Food & Service Feedback: Owner creates & reads own; SuperAdmin reads/deletes all
    match /feedback/{feedbackId} {
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdminToken()
      );

      allow get: if isSignedIn() && isValidId(feedbackId) && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );

      allow create: if isSignedIn() &&
                       isValidId(feedbackId) &&
                       incoming().keys().hasAll(['userId', 'customerName', 'customerEmail', 'branchId', 'branchName', 'foodRating', 'serviceRating', 'comment', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'customerName', 'customerEmail', 'branchId', 'branchName', 'foodRating', 'serviceRating', 'comment', 'createdAt', 'updatedAt']) &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidCafeFeedback(incoming());

      allow update: if false;
      allow delete: if isSuperAdmin() && isValidId(feedbackId);
    }
  }
}
